# Copy to .env and fill in. Make each secret long and random, for example:
#   openssl rand -hex 32
# Never commit .env.

# InfluxDB admin password and API token (the token is also what Grafana and
# the bridge use).
INFLUX_PASSWORD=
INFLUX_TOKEN=

# Grafana admin password (user: admin).
GRAFANA_PASSWORD=

# The secret at the end of the address you paste into Marrow:
#   https://<your-bridge-host>/<BRIDGE_TOKEN>
BRIDGE_TOKEN=

# Your time zone (IANA name, e.g. America/New_York, Europe/London). The
# bridge uses it to place meals logged after the fact. Set the same one in
# the dashboard's "Time zone" box.
TZ_NAME=UTC

# Optional: Cloudflare Tunnel token for `docker compose --profile tunnel up -d`.
TUNNEL_TOKEN=

# Optional: change the local ports.
# INFLUX_PORT=8086
# GRAFANA_PORT=3000
# BRIDGE_PORT=8799
